{
  "name": "agroferti-mic",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && tsc --noEmit -p worker && vite build",
    "dev:api": "vite build && wrangler dev --port 8787",
    "db:migrar:local": "wrangler d1 migrations apply agroferti-db --local",
    "db:migrar:nube": "wrangler d1 migrations apply agroferti-db --remote",
    "referencias:local": "node --experimental-strip-types scripts/referencias-sql.ts && wrangler d1 execute agroferti-db --local --file .wrangler/referencias.sql",
    "referencias:nube": "node --experimental-strip-types scripts/referencias-sql.ts && wrangler d1 execute agroferti-db --remote --file .wrangler/referencias.sql",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "dexie": "^4.2.0",
    "dexie-react-hooks": "^4.2.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261117.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.0.0",
    "wrangler": "4.164.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
